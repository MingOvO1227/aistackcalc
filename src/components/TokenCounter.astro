---
import modelsData from '../data/models.json';
import { TRANSLATIONS, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = TRANSLATIONS[locale].tokenCounter;
const llmT = TRANSLATIONS[locale].llm;

const defaultCurrency = locale === 'zh' ? 'CNY' : locale === 'ja' ? 'JPY' : (locale === 'de' || locale === 'fr') ? 'EUR' : 'USD';
const serializedModels = JSON.stringify(modelsData.models);
const serializedLabels = JSON.stringify({
  fitsYes: t.fitsYes,
  fitsNo: t.fitsNo,
  openBadge: llmT.openBadge,
  cheapestBadge: llmT.cheapestBadge,
  modelPrefix: locale === 'en' ? '/models/' : `/${locale}/models/`
});
---

<section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden transition-colors">
  <div class="p-6 sm:p-8 border-b border-slate-100 dark:border-slate-800 bg-gradient-to-br from-indigo-50/50 via-white to-violet-50/40 dark:from-slate-900 dark:via-slate-900 dark:to-indigo-950/30">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/70 px-3 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-300">
        🔒 {t.privacyBadge}
      </span>
      <select id="tc-currency" aria-label={llmT.currencyLabel} class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-3 py-1.5 text-xs font-semibold focus:border-indigo-500 focus:outline-none">
        <option value="USD" selected={defaultCurrency === 'USD'}>USD ($)</option>
        <option value="CNY" selected={defaultCurrency === 'CNY'}>CNY (¥)</option>
        <option value="EUR" selected={defaultCurrency === 'EUR'}>EUR (€)</option>
        <option value="JPY" selected={defaultCurrency === 'JPY'}>JPY (¥)</option>
        <option value="GBP" selected={defaultCurrency === 'GBP'}>GBP (£)</option>
      </select>
    </div>

    <h1 class="mt-4 text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      {t.title}
    </h1>
    <p class="mt-2 text-slate-600 dark:text-slate-300 max-w-3xl">{t.subtitle}</p>

    <div class="flex flex-wrap items-center gap-2 mt-6">
      <button type="button" data-sample="en" class="tc-sample px-3 py-1.5 rounded-full text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-300 transition cursor-pointer">
        {t.sampleEn}
      </button>
      <button type="button" data-sample="zh" class="tc-sample px-3 py-1.5 rounded-full text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-300 transition cursor-pointer">
        {t.sampleZh}
      </button>
      <button type="button" data-sample="code" class="tc-sample px-3 py-1.5 rounded-full text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-300 transition cursor-pointer">
        {t.sampleCode}
      </button>
      <button id="tc-clear" type="button" class="ml-auto px-3 py-1.5 rounded-full text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 transition cursor-pointer">
        {t.clearBtn}
      </button>
    </div>

    <textarea
      id="tc-input"
      rows="7"
      placeholder={t.placeholder}
      class="mt-3 w-full rounded-2xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 p-4 text-sm text-slate-900 dark:text-slate-100 placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none font-mono leading-relaxed"
    ></textarea>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-5">
      <div class="rounded-2xl bg-gradient-to-br from-indigo-600 to-violet-600 text-white p-4 shadow-sm">
        <div class="text-xs text-indigo-100 font-medium">{t.estTokens}</div>
        <div id="tc-tokens" class="mt-1 text-2xl sm:text-3xl font-extrabold tabular-nums">0</div>
      </div>
      <div class="rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 p-4">
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">{t.charsLabel}</div>
        <div id="tc-chars" class="mt-1 text-2xl font-bold text-slate-900 dark:text-white tabular-nums">0</div>
      </div>
      <div class="rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 p-4">
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">{t.wordsLabel}</div>
        <div id="tc-words" class="mt-1 text-2xl font-bold text-slate-900 dark:text-white tabular-nums">0</div>
      </div>
      <div class="rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 p-4">
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">{t.cjkLabel}</div>
        <div id="tc-cjk" class="mt-1 text-2xl font-bold text-slate-900 dark:text-white tabular-nums">0</div>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
      <div class="rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 p-4">
        <div class="flex justify-between text-xs font-semibold text-slate-600 dark:text-slate-300 mb-2">
          <label for="tc-out-tokens">{t.outputRatioLabel}</label>
          <span id="tc-out-val" class="text-indigo-600 dark:text-indigo-400 font-bold tabular-nums">500</span>
        </div>
        <input id="tc-out-tokens" type="range" min="0" max="8000" step="50" value="500" class="w-full" />
      </div>
      <div class="rounded-2xl bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 p-4">
        <div class="flex justify-between text-xs font-semibold text-slate-600 dark:text-slate-300 mb-2">
          <label for="tc-runs">{t.runsPerDayLabel}</label>
          <span id="tc-runs-val" class="text-indigo-600 dark:text-indigo-400 font-bold tabular-nums">100 / day</span>
        </div>
        <input id="tc-runs" type="range" min="1" max="5000" step="10" value="100" class="w-full" />
      </div>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-950/60 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
          <th class="py-3.5 pl-6 pr-3">{llmT.colModel}</th>
          <th class="py-3.5 px-3">{t.colFits}</th>
          <th class="py-3.5 px-3 text-right">{t.colSingleRun}</th>
          <th class="py-3.5 pl-3 pr-6 text-right">{t.colMonthlyRun}</th>
        </tr>
      </thead>
      <tbody id="tc-tbody" class="divide-y divide-slate-100 dark:divide-slate-800/80 text-sm"></tbody>
    </table>
  </div>
</section>

<script define:vars={{ serializedModels, serializedLabels }}>
  const MODELS = JSON.parse(serializedModels);
  const L = JSON.parse(serializedLabels);

  const RATES = {
    USD: { symbol: '$', rate: 1 },
    CNY: { symbol: '¥', rate: 7.25 },
    EUR: { symbol: '€', rate: 0.92 },
    JPY: { symbol: '¥', rate: 154 },
    GBP: { symbol: '£', rate: 0.79 }
  };

  const SAMPLES = {
    en: `You are an expert SaaS CFO and AI infrastructure architect. Analyze our quarterly customer support transcripts, categorize the top 10 churn triggers, estimate the exact engineering cost of automating L1 responses using retrieval-augmented generation (RAG), and return a structured JSON report with projected ROI over 12 months.`,
    zh: `请你扮演一名资深出海 SaaS 架构师与成本优化顾问。请阅读以下多语言客户工单摘要，提炼出导致付费用户流失的前 5 个核心痛点，并结合主流大模型 API 与云 GPU 自部署方案，输出一份包含月度 Token 预算、响应延迟对比及 12 个月投资回报率（ROI）的结构化分析报告。`,
    code: `export async function routeInference(prompt: string, budgetUsd: number) {\n  const estimatedTokens = Math.ceil(prompt.length / 3.8);\n  const candidates = models.filter((m) => m.contextLength > estimatedTokens * 2);\n  return candidates.sort((a, b) => a.blendedPerM - b.blendedPerM)[0];\n}`
  };

  const inputEl = document.getElementById('tc-input');
  const outEl = document.getElementById('tc-out-tokens');
  const runsEl = document.getElementById('tc-runs');
  const currEl = document.getElementById('tc-currency');
  const tbody = document.getElementById('tc-tbody');

  try {
    const savedCur = localStorage.getItem('currency');
    if (savedCur && RATES[savedCur]) currEl.value = savedCur;
  } catch {}
  currEl.addEventListener('change', () => {
    try { localStorage.setItem('currency', currEl.value); } catch {}
  });

  function esc(str) {
    return String(str).replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[ch]);
  }

  function estimateTokens(text) {
    if (!text) return { tokens: 0, chars: 0, words: 0, cjk: 0 };
    const chars = text.length;
    const cjkMatches = text.match(/[\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af]/g) || [];
    const cjk = cjkMatches.length;
    const nonCjk = text.replace(/[\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af]/g, ' ');
    const words = nonCjk.trim() ? nonCjk.trim().split(/\s+/).length : 0;
    const codeSymbols = (text.match(/[{}()[\];=<>/*+\-:"'`]/g) || []).length;
    const nonCjkChars = Math.max(0, chars - cjk);
    // Practical BPE heuristic: ~1.5 tokens per CJK char, ~0.26 tokens per Latin/ASCII char + code symbol density
    const tokens = Math.max(1, Math.round(cjk * 1.45 + nonCjkChars * 0.25 + codeSymbols * 0.15));
    return { tokens, chars, words, cjk };
  }

  function fmtMoney(usd) {
    const c = RATES[currEl.value] || RATES.USD;
    const v = usd * c.rate;
    if (!Number.isFinite(v) || v <= 0) return c.symbol + '0.00';
    if (v < 0.0001) return c.symbol + v.toFixed(6);
    if (v < 0.01) return c.symbol + v.toFixed(4);
    if (v < 1000) return c.symbol + (currEl.value === 'JPY' ? Math.round(v).toLocaleString('en-US') : v.toFixed(2));
    return c.symbol + Math.round(v).toLocaleString('en-US');
  }

  function render() {
    const stats = estimateTokens(inputEl.value);
    const outTokens = Number(outEl.value) || 0;
    const runsPerDay = Number(runsEl.value) || 1;
    const monthlyRuns = runsPerDay * 30;

    document.getElementById('tc-tokens').textContent = stats.tokens.toLocaleString('en-US');
    document.getElementById('tc-chars').textContent = stats.chars.toLocaleString('en-US');
    document.getElementById('tc-words').textContent = stats.words.toLocaleString('en-US');
    document.getElementById('tc-cjk').textContent = stats.cjk.toLocaleString('en-US');
    document.getElementById('tc-out-val').textContent = outTokens.toLocaleString('en-US');
    document.getElementById('tc-runs-val').textContent = runsPerDay.toLocaleString('en-US') + ' / day';

    const rows = MODELS.map((m) => {
      const perRun = (stats.tokens / 1_000_000) * m.inputPerM + (outTokens / 1_000_000) * m.outputPerM;
      const monthly = perRun * monthlyRuns;
      const fits = stats.tokens + outTokens <= m.contextLength;
      return { m, perRun, monthly, fits };
    }).sort((a, b) => a.perRun - b.perRun);

    tbody.innerHTML = rows.slice(0, 40).map(({ m, perRun, monthly, fits }, idx) => `
      <tr class="${idx === 0 ? 'bg-emerald-50/40 dark:bg-emerald-950/20' : 'hover:bg-slate-50 dark:hover:bg-slate-800/50'} transition">
        <td class="py-3.5 pl-6 pr-3">
          <div class="flex items-center gap-2 flex-wrap">
            <a href="${L.modelPrefix}${encodeURIComponent(m.slug)}/" class="font-semibold text-slate-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400">
              ${esc(m.name)}
            </a>
            ${idx === 0 ? `<span class="text-[11px] font-semibold bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 px-2 py-0.5 rounded-full">${esc(L.cheapestBadge)}</span>` : ''}
            ${m.openWeight ? `<span class="text-[11px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 px-2 py-0.5 rounded-full">${esc(L.openBadge)}</span>` : ''}
          </div>
          <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">${esc(m.provider)}</div>
        </td>
        <td class="py-3.5 px-3">
          ${fits
            ? `<span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400">✓ ${esc(L.fitsYes)}</span>`
            : `<span class="inline-flex items-center gap-1 text-xs font-semibold text-rose-600 dark:text-rose-400">✕ ${esc(L.fitsNo)}</span>`
          }
        </td>
        <td class="py-3.5 px-3 text-right font-semibold tabular-nums text-slate-800 dark:text-slate-200">${fmtMoney(perRun)}</td>
        <td class="py-3.5 pl-3 pr-6 text-right font-bold tabular-nums text-indigo-700 dark:text-indigo-400">${fmtMoney(monthly)}/mo</td>
      </tr>
    `).join('');
  }

  document.querySelectorAll('.tc-sample').forEach((btn) => {
    btn.addEventListener('click', () => {
      const k = btn.getAttribute('data-sample');
      if (SAMPLES[k]) {
        inputEl.value = SAMPLES[k];
        render();
      }
    });
  });

  document.getElementById('tc-clear').addEventListener('click', () => {
    inputEl.value = '';
    render();
  });

  [inputEl, outEl, runsEl, currEl].forEach((el) => {
    el.addEventListener('input', render);
    el.addEventListener('change', render);
  });

  // Start with a clean sample so the page feels immediately alive
  inputEl.value = document.documentElement.lang === 'zh' ? SAMPLES.zh : SAMPLES.en;
  render();
</script>
