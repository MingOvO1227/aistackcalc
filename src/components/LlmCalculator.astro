---
import modelsData from '../data/models.json';
import { TRANSLATIONS, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
  highlightSlug?: string;
}

const { locale = 'en', highlightSlug = '' } = Astro.props;
const t = TRANSLATIONS[locale].llm;

const providers = Array.from(new Set(modelsData.models.map((m) => m.provider))).sort();
const serializedModels = JSON.stringify(modelsData.models);
const serializedLabels = JSON.stringify({
  cheapestBadge: t.cheapestBadge,
  openBadge: t.openBadge,
  details: t.details,
  noModelsFound: t.noModelsFound,
  tiers: {
    budget: t.tierBudget,
    balanced: t.tierBalanced,
    flagship: t.tierFlagship,
    reasoning: t.tierReasoning
  },
  modelPrefix: locale === 'en' ? '/models/' : `/${locale}/models/`
});
---

<section id="llm-calculator" class="rounded-3xl border border-slate-200 bg-white shadow-sm overflow-hidden">
  <div class="p-6 sm:p-8 border-b border-slate-100 bg-gradient-to-br from-slate-50 via-white to-indigo-50/40">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900">{t.sectionTitle}</h2>
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-slate-500 mr-1">{t.presetsLabel}</span>
        <button type="button" data-preset="chatbot" class="preset-btn px-3 py-1.5 rounded-full text-xs font-semibold border border-indigo-200 bg-indigo-50 text-indigo-700 hover:bg-indigo-600 hover:text-white transition cursor-pointer">
          {t.presetChatbot}
        </button>
        <button type="button" data-preset="coding" class="preset-btn px-3 py-1.5 rounded-full text-xs font-semibold border border-slate-200 bg-white text-slate-700 hover:border-indigo-300 hover:text-indigo-700 transition cursor-pointer">
          {t.presetCoding}
        </button>
        <button type="button" data-preset="rag" class="preset-btn px-3 py-1.5 rounded-full text-xs font-semibold border border-slate-200 bg-white text-slate-700 hover:border-indigo-300 hover:text-indigo-700 transition cursor-pointer">
          {t.presetRag}
        </button>
        <button type="button" data-preset="content" class="preset-btn px-3 py-1.5 rounded-full text-xs font-semibold border border-slate-200 bg-white text-slate-700 hover:border-indigo-300 hover:text-indigo-700 transition cursor-pointer">
          {t.presetContent}
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <div class="rounded-2xl bg-white border border-slate-200 p-4">
        <div class="flex justify-between items-center text-xs font-semibold text-slate-600 mb-2">
          <label for="calc-reqs">{t.monthlyReqs}</label>
          <span id="val-reqs" class="text-indigo-700 font-bold tabular-nums">50,000</span>
        </div>
        <input id="calc-reqs" type="range" min="1000" max="2000000" step="1000" value="50000" class="w-full" />
        <input id="num-reqs" type="number" min="100" max="100000000" step="1000" value="50000" class="mt-2.5 w-full rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium tabular-nums focus:border-indigo-500 focus:outline-none" />
      </div>

      <div class="rounded-2xl bg-white border border-slate-200 p-4">
        <div class="flex justify-between items-center text-xs font-semibold text-slate-600 mb-2">
          <label for="calc-in">{t.inputTokens}</label>
          <span id="val-in" class="text-indigo-700 font-bold tabular-nums">1,500</span>
        </div>
        <input id="calc-in" type="range" min="100" max="100000" step="100" value="1500" class="w-full" />
        <input id="num-in" type="number" min="10" max="1000000" step="100" value="1500" class="mt-2.5 w-full rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium tabular-nums focus:border-indigo-500 focus:outline-none" />
      </div>

      <div class="rounded-2xl bg-white border border-slate-200 p-4">
        <div class="flex justify-between items-center text-xs font-semibold text-slate-600 mb-2">
          <label for="calc-out">{t.outputTokens}</label>
          <span id="val-out" class="text-indigo-700 font-bold tabular-nums">500</span>
        </div>
        <input id="calc-out" type="range" min="50" max="16000" step="50" value="500" class="w-full" />
        <input id="num-out" type="number" min="10" max="200000" step="50" value="500" class="mt-2.5 w-full rounded-lg border border-slate-200 px-3 py-1.5 text-sm font-medium tabular-nums focus:border-indigo-500 focus:outline-none" />
      </div>

      <div class="rounded-2xl bg-white border border-slate-200 p-4">
        <div class="flex justify-between items-center text-xs font-semibold text-slate-600 mb-2">
          <label for="calc-cache">{t.cacheRate}</label>
          <span id="val-cache" class="text-emerald-700 font-bold tabular-nums">20%</span>
        </div>
        <input id="calc-cache" type="range" min="0" max="90" step="5" value="20" class="w-full" />
        <p class="mt-3 text-xs text-slate-400">{t.cacheNote}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-5">
      <div class="rounded-2xl bg-slate-900 text-white p-4">
        <div class="text-xs text-slate-400 font-medium">{t.summaryTotalTokens}</div>
        <div id="kpi-tokens" class="mt-1 text-2xl font-bold tabular-nums">100.0M</div>
      </div>
      <div class="rounded-2xl bg-emerald-600 text-white p-4">
        <div class="text-xs text-emerald-100 font-medium">{t.summaryCheapest}</div>
        <div id="kpi-cheapest" class="mt-1 text-2xl font-bold tabular-nums">$0.00/mo</div>
        <div id="kpi-cheapest-name" class="text-xs text-emerald-100 mt-0.5 truncate">—</div>
      </div>
      <div class="rounded-2xl bg-indigo-600 text-white p-4">
        <div class="text-xs text-indigo-100 font-medium">{t.summaryPotentialSave}</div>
        <div id="kpi-savings" class="mt-1 text-2xl font-bold tabular-nums">$0.00/yr</div>
        <div id="kpi-savings-sub" class="text-xs text-indigo-100 mt-0.5">{t.savingsSub}</div>
      </div>
    </div>
  </div>

  <div class="p-4 sm:px-8 border-b border-slate-100 bg-white flex flex-wrap items-center gap-3">
    <input
      id="filter-search"
      type="text"
      placeholder={t.searchPlaceholder}
      class="flex-1 min-w-[200px] rounded-xl border border-slate-200 px-3.5 py-2 text-sm focus:border-indigo-500 focus:outline-none"
    />
    <select id="filter-provider" class="rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white focus:border-indigo-500 focus:outline-none">
      <option value="">{t.allProviders}</option>
      {providers.map((p) => <option value={p}>{p}</option>)}
    </select>
    <select id="filter-tier" class="rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white focus:border-indigo-500 focus:outline-none">
      <option value="">{t.allTiers}</option>
      <option value="budget">{t.tierBudget}</option>
      <option value="balanced">{t.tierBalanced}</option>
      <option value="flagship">{t.tierFlagship}</option>
      <option value="reasoning">{t.tierReasoning}</option>
    </select>
    <label class="inline-flex items-center gap-2 text-sm text-slate-700 cursor-pointer select-none px-2">
      <input id="filter-open" type="checkbox" class="rounded border-slate-300 text-indigo-600" />
      <span>{t.openWeightOnly}</span>
    </label>
    <select id="filter-sort" class="rounded-xl border border-slate-200 px-3 py-2 text-sm bg-white focus:border-indigo-500 focus:outline-none">
      <option value="monthly">{t.sortMonthly}</option>
      <option value="input">{t.sortInput}</option>
      <option value="output">{t.sortOutput}</option>
      <option value="context">{t.sortContext}</option>
    </select>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-200 bg-slate-50/80 text-xs font-semibold uppercase tracking-wider text-slate-500">
          <th class="py-3.5 pl-6 pr-3">{t.colModel}</th>
          <th class="py-3.5 px-3">{t.colContext}</th>
          <th class="py-3.5 px-3">{t.colRates}</th>
          <th class="py-3.5 px-3 text-right">{t.colMonthly}</th>
          <th class="py-3.5 px-3 text-right hidden sm:table-cell">{t.colYearly}</th>
          <th class="py-3.5 pl-3 pr-6 text-right">{t.colAction}</th>
        </tr>
      </thead>
      <tbody id="models-tbody" class="divide-y divide-slate-100 text-sm"></tbody>
    </table>
  </div>
</section>

<script define:vars={{ serializedModels, serializedLabels, highlightSlug }}>
  const MODELS = JSON.parse(serializedModels);
  const LABELS = JSON.parse(serializedLabels);

  const PRESETS = {
    chatbot: { reqs: 50000, inTok: 1500, outTok: 500, cache: 25 },
    coding: { reqs: 20000, inTok: 12000, outTok: 1800, cache: 50 },
    rag: { reqs: 100000, inTok: 6000, outTok: 600, cache: 40 },
    content: { reqs: 10000, inTok: 2000, outTok: 2500, cache: 10 }
  };

  const els = {
    reqsRange: document.getElementById('calc-reqs'),
    reqsNum: document.getElementById('num-reqs'),
    reqsVal: document.getElementById('val-reqs'),
    inRange: document.getElementById('calc-in'),
    inNum: document.getElementById('num-in'),
    inVal: document.getElementById('val-in'),
    outRange: document.getElementById('calc-out'),
    outNum: document.getElementById('num-out'),
    outVal: document.getElementById('val-out'),
    cacheRange: document.getElementById('calc-cache'),
    cacheVal: document.getElementById('val-cache'),
    search: document.getElementById('filter-search'),
    provider: document.getElementById('filter-provider'),
    tier: document.getElementById('filter-tier'),
    open: document.getElementById('filter-open'),
    sort: document.getElementById('filter-sort'),
    tbody: document.getElementById('models-tbody'),
    kpiTokens: document.getElementById('kpi-tokens'),
    kpiCheapest: document.getElementById('kpi-cheapest'),
    kpiCheapestName: document.getElementById('kpi-cheapest-name'),
    kpiSavings: document.getElementById('kpi-savings')
  };

  function fmtUsd(n) {
    if (!Number.isFinite(n) || n <= 0) return '$0.00';
    if (n < 0.01) return '$' + n.toFixed(4);
    if (n < 1000) return '$' + n.toFixed(2);
    return '$' + Math.round(n).toLocaleString('en-US');
  }

  function fmtCtx(c) {
    if (c >= 1000000) return (c / 1000000).toFixed(c % 1000000 === 0 ? 0 : 1) + 'M';
    return Math.round(c / 1000) + 'K';
  }

  function fmtRate(r) {
    return r >= 1 ? '$' + r.toFixed(2) : '$' + r.toFixed(3);
  }

  function escapeHtml(str) {
    return String(str).replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[ch]);
  }

  function computeMonthly(m, reqs, inTok, outTok, cachePct) {
    const effInputFactor = 1 - (cachePct / 100) * 0.5;
    const totalInM = (reqs * inTok) / 1_000_000;
    const totalOutM = (reqs * outTok) / 1_000_000;
    return totalInM * m.inputPerM * effInputFactor + totalOutM * m.outputPerM;
  }

  function render() {
    const reqs = Math.max(0, Number(els.reqsNum.value) || 0);
    const inTok = Math.max(0, Number(els.inNum.value) || 0);
    const outTok = Math.max(0, Number(els.outNum.value) || 0);
    const cachePct = Math.max(0, Math.min(95, Number(els.cacheRange.value) || 0));

    els.reqsVal.textContent = reqs.toLocaleString('en-US');
    els.inVal.textContent = inTok.toLocaleString('en-US');
    els.outVal.textContent = outTok.toLocaleString('en-US');
    els.cacheVal.textContent = cachePct + '%';

    const totalTokensM = (reqs * (inTok + outTok)) / 1_000_000;
    els.kpiTokens.textContent = totalTokensM >= 1000
      ? (totalTokensM / 1000).toFixed(2) + 'B'
      : totalTokensM.toFixed(1) + 'M';

    const q = (els.search.value || '').trim().toLowerCase();
    const prov = els.provider.value;
    const tier = els.tier.value;
    const openOnly = els.open.checked;
    const sortBy = els.sort.value;

    const scored = MODELS.map((m) => ({
      ...m,
      monthly: computeMonthly(m, reqs, inTok, outTok, cachePct)
    }));

    const cheapestGlobal = [...scored].sort((a, b) => a.monthly - b.monthly)[0];
    const priciestGlobal = [...scored].sort((a, b) => b.monthly - a.monthly)[0];
    if (cheapestGlobal) {
      els.kpiCheapest.textContent = fmtUsd(cheapestGlobal.monthly) + '/mo';
      els.kpiCheapestName.textContent = cheapestGlobal.provider + ' · ' + cheapestGlobal.name;
    }
    if (cheapestGlobal && priciestGlobal) {
      const saveYr = Math.max(0, (priciestGlobal.monthly - cheapestGlobal.monthly) * 12);
      els.kpiSavings.textContent = fmtUsd(saveYr) + '/yr';
    }

    let filtered = scored.filter((m) => {
      if (prov && m.provider !== prov) return false;
      if (tier && m.tier !== tier) return false;
      if (openOnly && !m.openWeight) return false;
      if (q && !(m.name.toLowerCase().includes(q) || m.provider.toLowerCase().includes(q) || m.id.toLowerCase().includes(q))) {
        return false;
      }
      return true;
    });

    filtered.sort((a, b) => {
      if (sortBy === 'input') return a.inputPerM - b.inputPerM;
      if (sortBy === 'output') return a.outputPerM - b.outputPerM;
      if (sortBy === 'context') return b.contextLength - a.contextLength;
      return a.monthly - b.monthly;
    });

    const lowestFiltered = filtered.length ? Math.min(...filtered.map((x) => x.monthly)) : 0;

    if (!filtered.length) {
      els.tbody.innerHTML = `<tr><td colspan="6" class="py-10 px-6 text-center text-sm text-slate-500">${escapeHtml(LABELS.noModelsFound)}</td></tr>`;
      return;
    }

    els.tbody.innerHTML = filtered.map((m, idx) => {
      const isCheapest = idx === 0 && sortBy === 'monthly' && m.monthly <= lowestFiltered * 1.001;
      const isHighlighted = highlightSlug && m.slug === highlightSlug;
      const tierLabel = (LABELS.tiers && LABELS.tiers[m.tier]) || m.tier;
      const rowBg = isHighlighted
        ? 'bg-indigo-50/70'
        : isCheapest
          ? 'bg-emerald-50/40'
          : 'hover:bg-slate-50';
      return `
        <tr class="${rowBg} transition">
          <td class="py-3.5 pl-6 pr-3">
            <div class="flex items-center gap-2 flex-wrap">
              <a href="${LABELS.modelPrefix}${encodeURIComponent(m.slug)}/" class="font-semibold text-slate-900 hover:text-indigo-600 transition">
                ${escapeHtml(m.name)}
              </a>
              ${isCheapest ? `<span class="text-[11px] font-semibold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">${escapeHtml(LABELS.cheapestBadge)}</span>` : ''}
              ${m.openWeight ? `<span class="text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full">${escapeHtml(LABELS.openBadge)}</span>` : ''}
            </div>
            <div class="text-xs text-slate-500 mt-0.5">${escapeHtml(m.provider)} · <span>${escapeHtml(tierLabel)}</span></div>
          </td>
          <td class="py-3.5 px-3 tabular-nums text-slate-600 font-medium">${fmtCtx(m.contextLength)}</td>
          <td class="py-3.5 px-3 tabular-nums text-slate-600">
            <span class="font-medium text-slate-800">${fmtRate(m.inputPerM)}</span>
            <span class="text-slate-400"> / </span>
            <span class="font-medium text-slate-800">${fmtRate(m.outputPerM)}</span>
          </td>
          <td class="py-3.5 px-3 text-right font-bold tabular-nums text-slate-900">${fmtUsd(m.monthly)}</td>
          <td class="py-3.5 px-3 text-right tabular-nums text-slate-600 hidden sm:table-cell">${fmtUsd(m.monthly * 12)}</td>
          <td class="py-3.5 pl-3 pr-6 text-right">
            <a href="${LABELS.modelPrefix}${encodeURIComponent(m.slug)}/" class="inline-flex items-center text-xs font-semibold text-indigo-600 hover:text-indigo-800">
              ${escapeHtml(LABELS.details)} →
            </a>
          </td>
        </tr>
      `;
    }).join('');
  }

  function syncPair(rangeEl, numEl) {
    rangeEl.addEventListener('input', () => { numEl.value = rangeEl.value; render(); });
    numEl.addEventListener('input', () => {
      const v = Number(numEl.value) || 0;
      rangeEl.value = String(Math.min(Number(rangeEl.max), Math.max(Number(rangeEl.min), v)));
      render();
    });
  }

  syncPair(els.reqsRange, els.reqsNum);
  syncPair(els.inRange, els.inNum);
  syncPair(els.outRange, els.outNum);
  els.cacheRange.addEventListener('input', render);

  [els.search, els.provider, els.tier, els.open, els.sort].forEach((el) => {
    el.addEventListener('input', render);
    el.addEventListener('change', render);
  });

  document.querySelectorAll('.preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const p = PRESETS[btn.getAttribute('data-preset')];
      if (!p) return;
      els.reqsNum.value = p.reqs;
      els.reqsRange.value = Math.min(Number(els.reqsRange.max), p.reqs);
      els.inNum.value = p.inTok;
      els.inRange.value = Math.min(Number(els.inRange.max), p.inTok);
      els.outNum.value = p.outTok;
      els.outRange.value = Math.min(Number(els.outRange.max), p.outTok);
      els.cacheRange.value = p.cache;
      document.querySelectorAll('.preset-btn').forEach((b) => {
        b.classList.remove('bg-indigo-50', 'text-indigo-700', 'border-indigo-200');
        b.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
      });
      btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
      btn.classList.add('bg-indigo-50', 'text-indigo-700', 'border-indigo-200');
      render();
    });
  });

  render();
</script>
