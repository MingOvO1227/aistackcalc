---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateBanner from './AffiliateBanner.astro';
import { TRANSLATIONS, localePath, type Locale } from '../i18n/translations';
import { formatContext } from '../utils/format';

interface ModelItem {
  id: string;
  slug: string;
  name: string;
  providerKey: string;
  provider: string;
  openWeight: boolean;
  inputPerM: number;
  outputPerM: number;
  blendedPerM: number;
  contextLength: number;
  tier: string;
  description: string;
}

interface Props {
  locale: Locale;
  a: ModelItem;
  b: ModelItem;
}

const { locale, a, b } = Astro.props;
const t = TRANSLATIONS[locale].compare;
const navT = TRANSLATIONS[locale].nav;
const llmT = TRANSLATIONS[locale].llm;
const defaultCurrency = locale === 'zh' ? 'CNY' : locale === 'ja' ? 'JPY' : (locale === 'de' || locale === 'fr') ? 'EUR' : 'USD';

const isTie = Math.abs(a.blendedPerM - b.blendedPerM) < 0.0001;
const cheaper = a.blendedPerM <= b.blendedPerM ? a : b;
const pricier = a.blendedPerM <= b.blendedPerM ? b : a;
const diffPct = !isTie && pricier.blendedPerM > 0
  ? Math.round((1 - cheaper.blendedPerM / pricier.blendedPerM) * 100)
  : 0;

const pairSlug = `${a.slug}-vs-${b.slug}`;
const title = `${a.name} vs ${b.name} · ${t.pageTitle}`;
const description = isTie
  ? `${a.provider} ${a.name} ($${a.inputPerM}/$${a.outputPerM}) vs ${b.provider} ${b.name} ($${b.inputPerM}/$${b.outputPerM}) — ${t.priceTieBadge}.`
  : `${a.provider} ${a.name} ($${a.inputPerM}/$${a.outputPerM}) vs ${b.provider} ${b.name} ($${b.inputPerM}/$${b.outputPerM}) — ${cheaper.name} (${diffPct}% ${t.lowerBlended}).`;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={localePath(locale, `compare/${pairSlug}/`)}
  multilingualPath={`compare/${pairSlug}/`}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
    <nav class="text-xs font-medium text-slate-500 dark:text-slate-400 mb-6 flex items-center gap-2 flex-wrap">
      <a href={localePath(locale)} class="hover:text-indigo-600 dark:hover:text-indigo-400">{t.homeCrumb}</a>
      <span>/</span>
      <a href={localePath(locale, 'compare/')} class="hover:text-indigo-600 dark:hover:text-indigo-400">{navT.compare}</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">{a.name} vs {b.name}</span>
    </nav>

    <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-8 shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3">
        {isTie ? (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 dark:bg-indigo-950/70 border border-indigo-200 dark:border-indigo-800 px-3 py-1 text-xs font-bold text-indigo-700 dark:text-indigo-300">
            {t.priceTieBadge}
          </span>
        ) : (
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800 px-3 py-1 text-xs font-bold text-emerald-700 dark:text-emerald-300">
            {t.costWinner}: {cheaper.name} ({diffPct}% {t.lowerBlended})
          </span>
        )}
        <select id="cmpd-currency" aria-label={llmT.currencyLabel} class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-3 py-1.5 text-xs font-bold focus:border-indigo-500 focus:outline-none">
          <option value="USD" selected={defaultCurrency === 'USD'}>USD ($)</option>
          <option value="CNY" selected={defaultCurrency === 'CNY'}>CNY (¥)</option>
          <option value="EUR" selected={defaultCurrency === 'EUR'}>EUR (€)</option>
          <option value="JPY" selected={defaultCurrency === 'JPY'}>JPY (¥)</option>
          <option value="GBP" selected={defaultCurrency === 'GBP'}>GBP (£)</option>
        </select>
      </div>
      <h1 class="mt-4 text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {a.name} vs {b.name}
      </h1>
      <p class="mt-2 text-slate-600 dark:text-slate-300">{description}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-8">
        {[a, b].map((m) => (
          <div class={`rounded-2xl border-2 p-6 ${!isTie && m.slug === cheaper.slug ? 'border-emerald-400 dark:border-emerald-500/70 bg-emerald-50/30 dark:bg-emerald-950/20' : 'border-slate-200 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/40'}`}>
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">{m.provider}</span>
              {!isTie && m.slug === cheaper.slug && (
                <span class="text-xs font-bold bg-emerald-600 text-white px-2.5 py-0.5 rounded-full">{t.cheaperOption}</span>
              )}
              {isTie && (
                <span class="text-xs font-bold bg-indigo-100 dark:bg-indigo-900/70 text-indigo-700 dark:text-indigo-300 px-2.5 py-0.5 rounded-full">{t.samePriceTag}</span>
              )}
            </div>
            <h2 class="mt-2 text-xl font-extrabold text-slate-900 dark:text-white">
              <a href={localePath(locale, `models/${m.slug}/`)} class="hover:text-indigo-600 dark:hover:text-indigo-400">{m.name}</a>
            </h2>
            <dl class="mt-4 space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-slate-500 dark:text-slate-400">{t.inputPerM}</dt>
                <dd id={`cmp-in-${m.slug === a.slug ? 'a' : 'b'}`} class="font-bold text-slate-900 dark:text-white tabular-nums">${m.inputPerM}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-500 dark:text-slate-400">{t.outputPerM}</dt>
                <dd id={`cmp-out-${m.slug === a.slug ? 'a' : 'b'}`} class="font-bold text-slate-900 dark:text-white tabular-nums">${m.outputPerM}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-500 dark:text-slate-400">{t.contextWindow}</dt>
                <dd class="font-bold text-slate-900 dark:text-white tabular-nums">{formatContext(m.contextLength)}</dd>
              </div>
              <div class="flex justify-between pt-2 border-t border-slate-200 dark:border-slate-700">
                <dt class="text-slate-600 dark:text-slate-300 font-semibold">{t.estMonthlyBill}</dt>
                <dd id={`cmp-bill-${m.slug === a.slug ? 'a' : 'b'}`} class="text-lg font-extrabold text-indigo-700 dark:text-indigo-400 tabular-nums">$0.00</dd>
              </div>
            </dl>
          </div>
        ))}
      </div>

      <div class="mt-6 rounded-2xl bg-slate-900 dark:bg-slate-950 border border-slate-800 text-white p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex-1">
            <div class="flex justify-between text-xs text-slate-300 font-semibold mb-2">
              <label for="cmp-reqs">{t.adjustReqs}</label>
              <span id="cmp-reqs-val" class="text-indigo-300 font-bold tabular-nums">100,000</span>
            </div>
            <input id="cmp-reqs" type="range" min="5000" max="2000000" step="5000" value="100000" class="w-full" />
          </div>
          <div class="sm:text-right shrink-0">
            <div class="text-xs text-slate-400">
              {isTie ? t.priceTieBadge : `${t.annualSavingsWith} ${cheaper.name}`}
            </div>
            <div id="cmp-save-yr" class="text-2xl font-extrabold text-emerald-400 tabular-nums">$0/yr</div>
          </div>
        </div>
      </div>
    </div>

    <AffiliateBanner locale={locale} partnerKeys={['runpod', 'elevenlabs', 'zapier', 'webflow']} />
  </div>
</BaseLayout>

<script define:vars={{ aIn: a.inputPerM, aOut: a.outputPerM, bIn: b.inputPerM, bOut: b.outputPerM }}>
  const slider = document.getElementById('cmp-reqs');
  const currEl = document.getElementById('cmpd-currency');
  const RATES = {
    USD: { symbol: '$', rate: 1 },
    CNY: { symbol: '¥', rate: 7.25 },
    EUR: { symbol: '€', rate: 0.92 },
    JPY: { symbol: '¥', rate: 154 },
    GBP: { symbol: '£', rate: 0.79 }
  };
  try {
    const saved = localStorage.getItem('currency');
    if (saved && RATES[saved]) currEl.value = saved;
  } catch {}
  function fmt(usd) {
    const c = RATES[currEl.value] || RATES.USD;
    const n = usd * c.rate;
    if (!Number.isFinite(n) || n <= 0) return c.symbol + '0';
    if (n < 0.01) return c.symbol + n.toFixed(4);
    if (currEl.value === 'JPY') return c.symbol + Math.round(n).toLocaleString('en-US');
    if (n < 1000) return c.symbol + n.toFixed(2);
    return c.symbol + Math.round(n).toLocaleString('en-US');
  }
  function fmtRate(usd) {
    const c = RATES[currEl.value] || RATES.USD;
    const n = usd * c.rate;
    if (currEl.value === 'JPY') return c.symbol + (n >= 10 ? Math.round(n) : n.toFixed(1));
    return c.symbol + (n >= 1 ? n.toFixed(2) : n.toFixed(3));
  }
  function update() {
    const reqs = Number(slider.value);
    document.getElementById('cmp-reqs-val').textContent = reqs.toLocaleString('en-US');
    document.getElementById('cmp-in-a').textContent = fmtRate(aIn);
    document.getElementById('cmp-out-a').textContent = fmtRate(aOut);
    document.getElementById('cmp-in-b').textContent = fmtRate(bIn);
    document.getElementById('cmp-out-b').textContent = fmtRate(bOut);
    const inM = (reqs * 1500) / 1_000_000;
    const outM = (reqs * 500) / 1_000_000;
    const costA = inM * aIn + outM * aOut;
    const costB = inM * bIn + outM * bOut;
    document.getElementById('cmp-bill-a').textContent = fmt(costA) + '/mo';
    document.getElementById('cmp-bill-b').textContent = fmt(costB) + '/mo';
    document.getElementById('cmp-save-yr').textContent = fmt(Math.abs(costA - costB) * 12) + '/yr';
  }
  slider.addEventListener('input', update);
  currEl.addEventListener('change', () => {
    try { localStorage.setItem('currency', currEl.value); } catch {}
    update();
  });
  update();
</script>
