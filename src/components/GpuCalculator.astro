---
import affiliates from '../config/affiliates.json';
import { TRANSLATIONS, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = TRANSLATIONS[locale].gpu;
const rp = affiliates.partners.runpod;
---

<section class="rounded-3xl border border-slate-200 bg-white shadow-sm overflow-hidden">
  <div class="p-6 sm:p-8 border-b border-slate-100 bg-gradient-to-br from-slate-50 via-white to-indigo-50/40">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">{t.title}</h1>
    <p class="mt-2 text-slate-600 max-w-2xl">{t.subtitle}</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-8">
      <div class="rounded-2xl bg-white border border-slate-200 p-5">
        <div class="flex justify-between text-xs font-semibold text-slate-600 mb-2">
          <label for="gpu-tokens">{t.monthlyMillions}</label>
          <span id="g-tokens" class="text-indigo-700 font-bold tabular-nums">500M</span>
        </div>
        <input id="gpu-tokens" type="range" min="10" max="5000" step="10" value="500" class="w-full" />
        <p class="mt-2 text-xs text-slate-400">Combined monthly input + output tokens</p>
      </div>

      <div class="rounded-2xl bg-white border border-slate-200 p-5">
        <div class="flex justify-between text-xs font-semibold text-slate-600 mb-2">
          <label for="gpu-hours">{t.hoursPerDay}</label>
          <span id="g-hours" class="text-indigo-700 font-bold tabular-nums">12 hrs/day</span>
        </div>
        <input id="gpu-hours" type="range" min="1" max="24" step="1" value="12" class="w-full" />
        <p class="mt-2 text-xs text-slate-400">Use Serverless GPU if traffic is spiky (&lt; 6 hrs/day)</p>
      </div>

      <div class="rounded-2xl bg-white border border-slate-200 p-5">
        <label for="gpu-tier" class="block text-xs font-semibold text-slate-600 mb-2">Cloud GPU Instance (RunPod Est.)</label>
        <select id="gpu-tier" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium bg-white">
          <option value="0.39">RTX 4090 (24GB) · ~$0.39/hr (7B–14B models)</option>
          <option value="0.79" selected>L40S (48GB) · ~$0.79/hr (32B–70B Quantized)</option>
          <option value="1.64">A100 80GB · ~$1.64/hr (70B FP8/INT8)</option>
          <option value="2.39">H100 80GB · ~$2.39/hr (High-throughput 70B+)</option>
        </select>
        <label for="api-rate" class="block text-xs font-semibold text-slate-600 mt-3 mb-1">Compared API Blended Rate ($/1M)</label>
        <select id="api-rate" class="w-full rounded-xl border border-slate-200 px-3 py-2 text-sm font-medium bg-white">
          <option value="0.5">Budget API (~$0.50/1M)</option>
          <option value="2.5" selected>Mid-Tier Flagship API (~$2.50/1M)</option>
          <option value="6.0">Premium Flagship API (~$6.00/1M)</option>
        </select>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6">
      <div class="rounded-2xl bg-slate-900 text-white p-5">
        <div class="text-xs text-slate-400">{t.apiCostLabel}</div>
        <div id="gpu-api-cost" class="mt-1 text-2xl font-bold tabular-nums">$1,250/mo</div>
      </div>
      <div class="rounded-2xl bg-indigo-600 text-white p-5">
        <div class="text-xs text-indigo-100">{t.gpuCostLabel}</div>
        <div id="gpu-self-cost" class="mt-1 text-2xl font-bold tabular-nums">$284/mo</div>
      </div>
      <div id="gpu-verdict-box" class="rounded-2xl bg-emerald-600 text-white p-5">
        <div id="gpu-verdict-title" class="text-xs text-emerald-100 font-semibold">{t.verdictSelfHost}</div>
        <div id="gpu-delta" class="mt-1 text-2xl font-bold tabular-nums">Save $966/mo</div>
      </div>
    </div>
  </div>

  <div class="p-6 sm:p-8 bg-slate-950 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div>
      <span class="inline-block text-xs font-semibold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 px-3 py-1 rounded-full">
        {rp.badge}
      </span>
      <h2 class="mt-3 text-xl font-bold">{t.ctaHeadline}</h2>
      <p class="mt-1 text-sm text-slate-300 max-w-xl">{rp.highlight}. Spin up vLLM containers for DeepSeek, Llama & Qwen in under 60 seconds with zero long-term contracts.</p>
    </div>
    <a
      href={rp.url}
      target="_blank"
      rel="sponsored noopener noreferrer"
      class="shrink-0 inline-flex items-center justify-center rounded-xl bg-emerald-500 hover:bg-emerald-400 px-6 py-3.5 text-sm font-bold text-slate-950 shadow-lg transition"
    >
      {rp.ctaText} →
    </a>
  </div>
</section>

<script define:vars={{ verdictSelf: t.verdictSelfHost, verdictApi: t.verdictUseApi }}>
  const tokEl = document.getElementById('gpu-tokens');
  const hrsEl = document.getElementById('gpu-hours');
  const tierEl = document.getElementById('gpu-tier');
  const apiRateEl = document.getElementById('api-rate');

  function updateGpu() {
    const millions = Number(tokEl.value);
    const hrs = Number(hrsEl.value);
    const hourlyRate = Number(tierEl.value);
    const apiBlended = Number(apiRateEl.value);

    document.getElementById('g-tokens').textContent = millions >= 1000
      ? (millions / 1000).toFixed(2) + 'B'
      : millions + 'M';
    document.getElementById('g-hours').textContent = hrs + ' hrs/day';

    const apiCost = millions * apiBlended;
    const gpuCost = hrs * 30 * hourlyRate;
    const diff = apiCost - gpuCost;

    document.getElementById('gpu-api-cost').textContent = '$' + Math.round(apiCost).toLocaleString('en-US') + '/mo';
    document.getElementById('gpu-self-cost').textContent = '$' + Math.round(gpuCost).toLocaleString('en-US') + '/mo';

    const vBox = document.getElementById('gpu-verdict-box');
    const vTitle = document.getElementById('gpu-verdict-title');
    const vDelta = document.getElementById('gpu-delta');

    if (diff > 0) {
      vBox.className = 'rounded-2xl bg-emerald-600 text-white p-5';
      vTitle.textContent = verdictSelf;
      vDelta.textContent = 'Save $' + Math.round(diff).toLocaleString('en-US') + '/mo';
    } else {
      vBox.className = 'rounded-2xl bg-amber-600 text-white p-5';
      vTitle.textContent = verdictApi;
      vDelta.textContent = 'API saves $' + Math.round(Math.abs(diff)).toLocaleString('en-US') + '/mo';
    }
  }

  [tokEl, hrsEl, tierEl, apiRateEl].forEach((el) => {
    el.addEventListener('input', updateGpu);
    el.addEventListener('change', updateGpu);
  });
  updateGpu();
</script>
