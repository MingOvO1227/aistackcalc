---
import affiliates from '../config/affiliates.json';
import { TRANSLATIONS, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
  partnerKeys?: (keyof typeof affiliates.partners)[];
  compact?: boolean;
}

const {
  locale = 'en',
  partnerKeys = ['elevenlabs', 'runpod', 'webflow', 'notion'],
  compact = false
} = Astro.props;

const t = TRANSLATIONS[locale];
const list = partnerKeys.map((k) => ({ key: k, ...affiliates.partners[k] })).filter(Boolean);
---

<section class={compact ? 'mt-8' : 'mt-14'}>
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-5">
    <div>
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">{t.partners.heading}</h2>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">{t.partners.subheading}</p>
    </div>
    <span class="text-xs text-slate-400 dark:text-slate-500">{t.partners.disclosureShort}</span>
  </div>

  <div class={`grid grid-cols-1 ${list.length >= 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-2 lg:grid-cols-3'} gap-4`}>
    {list.map((p) => (
      <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-xs hover:border-indigo-400 dark:hover:border-indigo-500 hover:shadow-lg hover:shadow-indigo-500/10 hover:-translate-y-0.5 transition flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-indigo-600 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-950/70 border border-indigo-100 dark:border-indigo-900 px-2.5 py-1 rounded-full">
              {p.badge}
            </span>
            <span class="text-xs font-medium text-slate-500 dark:text-slate-400">{p.startingPrice}</span>
          </div>
          <h3 class="mt-3 text-lg font-bold text-slate-900 dark:text-white">{p.name}</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">{p.category}</p>
          <p class="mt-2.5 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{p.highlight}</p>
        </div>
        <a
          href={p.url}
          target="_blank"
          rel="sponsored noopener noreferrer"
          class="mt-5 inline-flex items-center justify-center w-full rounded-xl bg-slate-900 dark:bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-600 dark:hover:bg-indigo-500 transition"
        >
          {p.ctaText} →
        </a>
      </div>
    ))}
  </div>
</section>
