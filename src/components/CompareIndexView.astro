---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateBanner from './AffiliateBanner.astro';
import modelsData from '../data/models.json';
import { TRANSLATIONS, localePath, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = TRANSLATIONS[locale].compare;
const llmT = TRANSLATIONS[locale].llm;

const models = modelsData.models;
const defaultA = models[0]?.slug || '';
const defaultB = models.find((m) => m.providerKey !== models[0]?.providerKey && m.blendedPerM !== models[0]?.blendedPerM)?.slug || models[1]?.slug || defaultA;

const serializedModels = JSON.stringify(models);
const serializedLabels = JSON.stringify({
  costWinner: t.costWinner,
  lowerBlended: t.lowerBlended,
  cheaperOption: t.cheaperOption,
  priceTieBadge: t.priceTieBadge,
  samePriceTag: t.samePriceTag,
  inputPerM: t.inputPerM,
  outputPerM: t.outputPerM,
  contextWindow: t.contextWindow,
  estMonthlyBill: t.estMonthlyBill,
  annualSavingsWith: t.annualSavingsWith,
  openBadge: llmT.openBadge,
  details: llmT.details,
  tiers: {
    budget: llmT.tierBudget,
    balanced: llmT.tierBalanced,
    flagship: llmT.tierFlagship,
    reasoning: llmT.tierReasoning
  },
  modelPrefix: locale === 'en' ? '/models/' : `/${locale}/models/`
});
---

<BaseLayout
  title={t.pageTitle}
  description={t.pageSubtitle}
  locale={locale}
  canonicalPath={localePath(locale, 'compare/')}
  multilingualPath="compare/"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {t.customTitle}
      </h1>
      <p class="mt-2 text-slate-600">
        {t.pageSubtitle}
      </p>
    </div>

    <!-- Interactive Any-vs-Any Searchable Model Comparator -->
    <section class="mt-8 rounded-3xl border border-slate-200 bg-white shadow-sm overflow-hidden">
      <div class="p-6 sm:p-8 border-b border-slate-100 bg-gradient-to-br from-slate-50 via-white to-indigo-50/40">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] gap-4 items-end">
          <!-- Model A Picker -->
          <div class="rounded-2xl bg-white border border-slate-200 p-4 shadow-2xs">
            <label for="cmp-search-a" class="block text-xs font-bold uppercase tracking-wider text-indigo-600 mb-2">
              {t.selectModelA}
            </label>
            <input
              id="cmp-search-a"
              type="text"
              placeholder={t.filterModelPlaceholder}
              autocomplete="off"
              class="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-sm focus:border-indigo-500 focus:outline-none"
            />
            <select
              id="cmp-select-a"
              aria-label={t.selectModelA}
              class="mt-2.5 w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-900 focus:border-indigo-500 focus:bg-white focus:outline-none"
            ></select>
          </div>

          <!-- Swap Button -->
          <div class="flex justify-center lg:pb-2">
            <button
              id="cmp-swap-btn"
              type="button"
              title={t.swapBtn}
              class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 hover:border-indigo-400 hover:text-indigo-700 hover:bg-indigo-50 transition cursor-pointer shadow-2xs"
            >
              <span>⇄</span>
              <span>{t.swapBtn}</span>
            </button>
          </div>

          <!-- Model B Picker -->
          <div class="rounded-2xl bg-white border border-slate-200 p-4 shadow-2xs">
            <label for="cmp-search-b" class="block text-xs font-bold uppercase tracking-wider text-emerald-600 mb-2">
              {t.selectModelB}
            </label>
            <input
              id="cmp-search-b"
              type="text"
              placeholder={t.filterModelPlaceholder}
              autocomplete="off"
              class="w-full rounded-xl border border-slate-200 px-3.5 py-2 text-sm focus:border-indigo-500 focus:outline-none"
            />
            <select
              id="cmp-select-b"
              aria-label={t.selectModelB}
              class="mt-2.5 w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm font-semibold text-slate-900 focus:border-indigo-500 focus:bg-white focus:outline-none"
            ></select>
          </div>
        </div>

        <!-- Live Workload Sliders -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-5">
          <div class="rounded-2xl bg-white border border-slate-200 p-4">
            <div class="flex justify-between text-xs font-semibold text-slate-600 mb-2">
              <label for="live-reqs">{llmT.monthlyReqs}</label>
              <span id="live-reqs-val" class="text-indigo-700 font-bold tabular-nums">100,000</span>
            </div>
            <input id="live-reqs" type="range" min="1000" max="2000000" step="1000" value="100000" class="w-full" />
          </div>
          <div class="rounded-2xl bg-white border border-slate-200 p-4">
            <div class="flex justify-between text-xs font-semibold text-slate-600 mb-2">
              <label for="live-in">{llmT.inputTokens}</label>
              <span id="live-in-val" class="text-indigo-700 font-bold tabular-nums">1,500</span>
            </div>
            <input id="live-in" type="range" min="100" max="50000" step="100" value="1500" class="w-full" />
          </div>
          <div class="rounded-2xl bg-white border border-slate-200 p-4">
            <div class="flex justify-between text-xs font-semibold text-slate-600 mb-2">
              <label for="live-out">{llmT.outputTokens}</label>
              <span id="live-out-val" class="text-indigo-700 font-bold tabular-nums">500</span>
            </div>
            <input id="live-out" type="range" min="50" max="10000" step="50" value="500" class="w-full" />
          </div>
        </div>
      </div>

      <!-- Live Comparison Result -->
      <div class="p-6 sm:p-8">
        <div id="live-winner-banner" class="mb-5"></div>
        <div id="live-cards" class="grid grid-cols-1 md:grid-cols-2 gap-5"></div>

        <div class="mt-6 rounded-2xl bg-slate-900 text-white p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div id="live-save-label" class="text-xs text-slate-400 font-medium">—</div>
            <div id="live-save-sub" class="text-xs text-slate-400 mt-1 tabular-nums">—</div>
          </div>
          <div id="live-save-yr" class="text-2xl sm:text-3xl font-extrabold text-emerald-400 tabular-nums">$0/yr</div>
        </div>
      </div>
    </section>

    <!-- Popular Pre-Built Comparisons (SEO Internal Links) -->
    <section class="mt-14">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
        <h2 class="text-xl font-bold text-slate-900">{t.popularPairsTitle}</h2>
        <input
          id="pair-filter"
          type="text"
          placeholder={t.filterModelPlaceholder}
          class="sm:w-80 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-sm focus:border-indigo-500 focus:outline-none"
        />
      </div>
      <div id="pairs-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        {modelsData.comparisons.map((c) => (
          <a
            href={localePath(locale, `compare/${c.slug}/`)}
            data-pair-title={c.title.toLowerCase()}
            class="pair-card rounded-2xl border border-slate-200 bg-white p-4 hover:border-indigo-400 hover:shadow-xs transition flex items-center justify-between gap-3"
          >
            <span class="text-sm font-semibold text-slate-800 truncate">{c.title}</span>
            <span class="text-xs font-bold text-indigo-600 shrink-0">{t.viewBtn} →</span>
          </a>
        ))}
      </div>
    </section>

    <AffiliateBanner locale={locale} partnerKeys={['elevenlabs', 'runpod', 'webflow', 'notion']} />
  </div>
</BaseLayout>

<script define:vars={{ serializedModels, serializedLabels, defaultA, defaultB }}>
  const MODELS = JSON.parse(serializedModels);
  const L = JSON.parse(serializedLabels);
  const bySlug = new Map(MODELS.map((m) => [m.slug, m]));

  const searchA = document.getElementById('cmp-search-a');
  const selectA = document.getElementById('cmp-select-a');
  const searchB = document.getElementById('cmp-search-b');
  const selectB = document.getElementById('cmp-select-b');
  const swapBtn = document.getElementById('cmp-swap-btn');

  const reqsEl = document.getElementById('live-reqs');
  const inEl = document.getElementById('live-in');
  const outEl = document.getElementById('live-out');

  const params = new URLSearchParams(window.location.search);
  let selectedA = bySlug.has(params.get('a')) ? params.get('a') : defaultA;
  let selectedB = bySlug.has(params.get('b')) ? params.get('b') : defaultB;

  function fmtUsd(n) {
    if (!Number.isFinite(n) || n <= 0) return '$0';
    if (n < 0.01) return '$' + n.toFixed(4);
    if (n < 1000) return '$' + n.toFixed(2);
    return '$' + Math.round(n).toLocaleString('en-US');
  }

  function fmtCtx(c) {
    if (c >= 1000000) return (c / 1000000).toFixed(c % 1000000 === 0 ? 0 : 1) + 'M';
    return Math.round(c / 1000) + 'K';
  }

  function esc(str) {
    return String(str).replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    })[ch]);
  }

  function populateSelect(selectEl, query, currentSlug) {
    const q = (query || '').trim().toLowerCase();
    const matches = MODELS.filter((m) =>
      !q || m.name.toLowerCase().includes(q) || m.provider.toLowerCase().includes(q) || m.id.toLowerCase().includes(q)
    );
    const list = matches.length ? matches : MODELS;
    selectEl.innerHTML = list.map((m) => {
      const label = `${m.provider} · ${m.name} ($${m.inputPerM} / $${m.outputPerM})`;
      return `<option value="${esc(m.slug)}">${esc(label)}</option>`;
    }).join('');

    if (list.some((m) => m.slug === currentSlug)) {
      selectEl.value = currentSlug;
    } else if (list.length) {
      selectEl.value = list[0].slug;
    }
    return selectEl.value;
  }

  function renderComparison() {
    const a = bySlug.get(selectedA) || MODELS[0];
    const b = bySlug.get(selectedB) || MODELS[1] || MODELS[0];
    if (!a || !b) return;

    const reqs = Number(reqsEl.value);
    const inTok = Number(inEl.value);
    const outTok = Number(outEl.value);

    document.getElementById('live-reqs-val').textContent = reqs.toLocaleString('en-US');
    document.getElementById('live-in-val').textContent = inTok.toLocaleString('en-US');
    document.getElementById('live-out-val').textContent = outTok.toLocaleString('en-US');

    const inM = (reqs * inTok) / 1_000_000;
    const outM = (reqs * outTok) / 1_000_000;
    const costA = inM * a.inputPerM + outM * a.outputPerM;
    const costB = inM * b.inputPerM + outM * b.outputPerM;

    const isTie = Math.abs(costA - costB) < 0.0001;
    const winner = costA <= costB ? a : b;
    const winnerCost = Math.min(costA, costB);
    const loserCost = Math.max(costA, costB);
    const diffPct = !isTie && loserCost > 0 ? Math.round((1 - winnerCost / loserCost) * 100) : 0;

    const banner = document.getElementById('live-winner-banner');
    if (isTie) {
      banner.innerHTML = `<span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 border border-indigo-200 px-3.5 py-1 text-xs font-bold text-indigo-700">${esc(L.priceTieBadge)}</span>`;
    } else {
      banner.innerHTML = `<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 border border-emerald-200 px-3.5 py-1 text-xs font-bold text-emerald-700">${esc(L.costWinner)}: ${esc(winner.name)} (${diffPct}% ${esc(L.lowerBlended)})</span>`;
    }

    const cardsData = [
      { m: a, cost: costA, isWinner: !isTie && costA < costB },
      { m: b, cost: costB, isWinner: !isTie && costB < costA }
    ];

    document.getElementById('live-cards').innerHTML = cardsData.map(({ m, cost, isWinner }) => {
      const tierLabel = (L.tiers && L.tiers[m.tier]) || m.tier;
      return `
        <div class="rounded-2xl border-2 p-6 ${isWinner ? 'border-emerald-400 bg-emerald-50/30' : 'border-slate-200 bg-slate-50/50'}">
          <div class="flex items-center justify-between gap-2 flex-wrap">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-indigo-600">${esc(m.provider)}</span>
              <span class="text-[11px] font-medium bg-white border border-slate-200 text-slate-600 px-2 py-0.5 rounded-full">${esc(tierLabel)}</span>
              ${m.openWeight ? `<span class="text-[11px] font-medium bg-slate-200/70 text-slate-700 px-2 py-0.5 rounded-full">${esc(L.openBadge)}</span>` : ''}
            </div>
            ${isWinner ? `<span class="text-xs font-bold bg-emerald-600 text-white px-2.5 py-0.5 rounded-full">${esc(L.cheaperOption)}</span>` : isTie ? `<span class="text-xs font-bold bg-indigo-100 text-indigo-700 px-2.5 py-0.5 rounded-full">${esc(L.samePriceTag)}</span>` : ''}
          </div>
          <div class="mt-2.5 flex items-baseline justify-between gap-2">
            <h3 class="text-xl font-extrabold text-slate-900">
              <a href="${L.modelPrefix}${encodeURIComponent(m.slug)}/" class="hover:text-indigo-600 transition">${esc(m.name)}</a>
            </h3>
            <a href="${L.modelPrefix}${encodeURIComponent(m.slug)}/" class="text-xs font-semibold text-indigo-600 hover:underline shrink-0">${esc(L.details)} →</a>
          </div>
          <dl class="mt-4 space-y-2 text-sm">
            <div class="flex justify-between">
              <dt class="text-slate-500">${esc(L.inputPerM)}</dt>
              <dd class="font-bold text-slate-900 tabular-nums">$${m.inputPerM}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-slate-500">${esc(L.outputPerM)}</dt>
              <dd class="font-bold text-slate-900 tabular-nums">$${m.outputPerM}</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-slate-500">${esc(L.contextWindow)}</dt>
              <dd class="font-bold text-slate-900 tabular-nums">${fmtCtx(m.contextLength)}</dd>
            </div>
            <div class="flex justify-between pt-3 border-t border-slate-200">
              <dt class="text-slate-700 font-semibold">${esc(L.estMonthlyBill)}</dt>
              <dd class="text-xl font-extrabold text-indigo-700 tabular-nums">${fmtUsd(cost)}/mo</dd>
            </div>
          </dl>
        </div>
      `;
    }).join('');

    const saveYr = Math.abs(costA - costB) * 12;
    document.getElementById('live-save-label').textContent = isTie
      ? L.priceTieBadge
      : `${L.annualSavingsWith} ${winner.name}`;
    document.getElementById('live-save-sub').textContent =
      `${a.name}: ${fmtUsd(costA * 12)}/yr · ${b.name}: ${fmtUsd(costB * 12)}/yr`;
    document.getElementById('live-save-yr').textContent = `${fmtUsd(saveYr)}/yr`;

    const nextUrl = new URL(window.location.href);
    nextUrl.searchParams.set('a', a.slug);
    nextUrl.searchParams.set('b', b.slug);
    window.history.replaceState({}, '', nextUrl.toString());
  }

  selectedA = populateSelect(selectA, '', selectedA);
  selectedB = populateSelect(selectB, '', selectedB);

  searchA.addEventListener('input', () => {
    selectedA = populateSelect(selectA, searchA.value, selectedA);
    renderComparison();
  });
  searchB.addEventListener('input', () => {
    selectedB = populateSelect(selectB, searchB.value, selectedB);
    renderComparison();
  });
  selectA.addEventListener('change', () => {
    selectedA = selectA.value;
    renderComparison();
  });
  selectB.addEventListener('change', () => {
    selectedB = selectB.value;
    renderComparison();
  });
  swapBtn.addEventListener('click', () => {
    const tmp = selectedA;
    selectedA = selectedB;
    selectedB = tmp;
    searchA.value = '';
    searchB.value = '';
    selectedA = populateSelect(selectA, '', selectedA);
    selectedB = populateSelect(selectB, '', selectedB);
    renderComparison();
  });

  [reqsEl, inEl, outEl].forEach((el) => el.addEventListener('input', renderComparison));

  const pairFilter = document.getElementById('pair-filter');
  if (pairFilter) {
    pairFilter.addEventListener('input', () => {
      const q = pairFilter.value.trim().toLowerCase();
      document.querySelectorAll('.pair-card').forEach((card) => {
        const title = card.getAttribute('data-pair-title') || '';
        card.style.display = !q || title.includes(q) ? '' : 'none';
      });
    });
  }

  renderComparison();
</script>
