---
import BaseLayout from '../layouts/BaseLayout.astro';
import AffiliateBanner from './AffiliateBanner.astro';
import modelsData from '../data/models.json';
import { TRANSLATIONS, localePath, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = TRANSLATIONS[locale].compare;
---

<BaseLayout
  title={t.pageTitle}
  description={t.pageSubtitle}
  locale={locale}
  canonicalPath={localePath(locale, 'compare/')}
  multilingualPath="compare/"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
      {t.pageTitle}
    </h1>
    <p class="mt-2 text-slate-600 max-w-2xl">
      {t.pageSubtitle}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
      {modelsData.comparisons.map((c) => (
        <a
          href={localePath(locale, `compare/${c.slug}/`)}
          class="rounded-2xl border border-slate-200 bg-white p-5 hover:border-indigo-400 hover:shadow-sm transition flex items-center justify-between gap-3"
        >
          <span class="text-sm font-bold text-slate-900">{c.title}</span>
          <span class="text-xs font-semibold text-indigo-600 shrink-0">{t.viewBtn} →</span>
        </a>
      ))}
    </div>

    <AffiliateBanner locale={locale} partnerKeys={['elevenlabs', 'runpod', 'webflow', 'notion']} />
  </div>
</BaseLayout>
