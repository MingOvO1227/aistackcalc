---
import affiliates from '../config/affiliates.json';
import { TRANSLATIONS, type Locale } from '../i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = TRANSLATIONS[locale].voice;
const el = affiliates.partners.elevenlabs;
---

<section class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden transition-colors">
  <div class="p-6 sm:p-8 border-b border-slate-100 dark:border-slate-800 bg-gradient-to-br from-indigo-50/50 via-white to-emerald-50/40 dark:from-slate-900 dark:via-slate-900 dark:to-indigo-950/30">
    <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">{t.title}</h1>
    <p class="mt-2 text-slate-600 dark:text-slate-300 max-w-2xl">{t.subtitle}</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-8">
      <div class="rounded-2xl bg-white dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700/80 p-5">
        <div class="flex justify-between text-xs font-semibold text-slate-600 dark:text-slate-300 mb-2">
          <label for="voice-mins">{t.monthlyMinutes}</label>
          <span id="v-mins" class="text-indigo-600 dark:text-indigo-400 font-bold tabular-nums">120 min</span>
        </div>
        <input id="voice-mins" type="range" min="10" max="2000" step="10" value="120" class="w-full" />
        <p class="mt-2 text-xs text-slate-400 dark:text-slate-400">~1,000 characters ≈ 1 min</p>
      </div>

      <div class="rounded-2xl bg-white dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700/80 p-5">
        <div class="flex justify-between text-xs font-semibold text-slate-600 dark:text-slate-300 mb-2">
          <label for="voice-langs">{t.dubbingLangs}</label>
          <span id="v-langs" class="text-indigo-600 dark:text-indigo-400 font-bold tabular-nums">2</span>
        </div>
        <input id="voice-langs" type="range" min="1" max="15" step="1" value="2" class="w-full" />
        <p class="mt-2 text-xs text-slate-400 dark:text-slate-400">YouTube / Course / Audiobook dubbing</p>
      </div>

      <div class="rounded-2xl bg-white dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700/80 p-5">
        <div class="flex justify-between text-xs font-semibold text-slate-600 dark:text-slate-300 mb-2">
          <label for="voice-human">{t.humanRatePerMin}</label>
          <span id="v-human" class="text-indigo-600 dark:text-indigo-400 font-bold tabular-nums">$15/min</span>
        </div>
        <input id="voice-human" type="range" min="3" max="60" step="1" value="15" class="w-full" />
        <p class="mt-2 text-xs text-slate-400 dark:text-slate-400">Studio / Freelance voice rate ($10–$35/min)</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
      <div class="rounded-2xl bg-slate-900 dark:bg-slate-950 border border-slate-800 text-white p-5">
        <div class="text-xs text-slate-400">{t.studioCostLabel}</div>
        <div id="res-studio" class="mt-1 text-xl xl:text-2xl font-bold tabular-nums">$3,600/mo</div>
      </div>
      <div class="rounded-2xl bg-gradient-to-br from-indigo-600 to-violet-600 text-white p-5">
        <div class="text-xs text-indigo-100">{t.aiCostLabel}</div>
        <div id="res-ai" class="mt-1 text-xl xl:text-2xl font-bold tabular-nums">$99/mo</div>
      </div>
      <div class="rounded-2xl bg-gradient-to-br from-emerald-600 to-teal-600 text-white p-5">
        <div class="text-xs text-emerald-100">{t.monthlySavingsLabel}</div>
        <div id="res-save" class="mt-1 text-xl xl:text-2xl font-bold tabular-nums">$3,501/mo</div>
        <div id="res-save-pct" class="text-xs text-emerald-100 mt-0.5">97% lower cost</div>
      </div>
      <div class="rounded-2xl bg-white dark:bg-slate-800 border-2 border-indigo-200 dark:border-indigo-500/50 p-5">
        <div class="text-xs text-slate-500 dark:text-slate-400 font-semibold">{t.recommendedPlan}</div>
        <div id="res-plan" class="mt-1 text-lg xl:text-xl font-extrabold text-indigo-700 dark:text-indigo-300">Pro ($99/mo)</div>
        <div id="res-chars" class="text-xs text-slate-500 dark:text-slate-400 mt-0.5 tabular-nums">240,000 chars / mo</div>
      </div>
    </div>
  </div>

  <div class="p-6 sm:p-8 bg-slate-950 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border-t border-slate-800">
    <div>
      <span class="inline-block text-xs font-semibold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-400/30 px-3 py-1 rounded-full">
        {el.badge}
      </span>
      <h2 class="mt-3 text-xl font-bold">{t.ctaHeadline}</h2>
      <p class="mt-1 text-sm text-slate-300 max-w-xl">{el.highlight} — starting at {el.startingPrice} with instant voice cloning & 29+ languages.</p>
    </div>
    <a
      href={el.url}
      target="_blank"
      rel="sponsored noopener noreferrer"
      class="shrink-0 inline-flex items-center justify-center rounded-xl bg-indigo-500 hover:bg-indigo-400 px-6 py-3.5 text-sm font-bold text-white shadow-lg transition"
    >
      {el.ctaText} →
    </a>
  </div>
</section>

<script>
  const minsEl = document.getElementById('voice-mins') as HTMLInputElement;
  const langsEl = document.getElementById('voice-langs') as HTMLInputElement;
  const humanEl = document.getElementById('voice-human') as HTMLInputElement;

  const PLANS = [
    { name: 'Starter', price: 5, chars: 30_000 },
    { name: 'Creator', price: 22, chars: 100_000 },
    { name: 'Pro', price: 99, chars: 500_000 },
    { name: 'Scale', price: 330, chars: 2_000_000 },
    { name: 'Business', price: 1320, chars: 11_000_000 }
  ];

  function updateVoice() {
    const mins = Number(minsEl.value);
    const langs = Number(langsEl.value);
    const humanRate = Number(humanEl.value);

    document.getElementById('v-mins')!.textContent = `${mins} min`;
    document.getElementById('v-langs')!.textContent = `${langs}`;
    document.getElementById('v-human')!.textContent = `$${humanRate}/min`;

    const totalMins = mins * langs;
    const totalChars = totalMins * 1000;
    const studioCost = totalMins * humanRate;

    let chosen = PLANS.find((p) => p.chars >= totalChars) || PLANS[PLANS.length - 1];
    let aiCost = chosen.price;
    if (totalChars > chosen.chars) {
      const extraChars = totalChars - chosen.chars;
      aiCost += Math.ceil(extraChars / 1000) * 0.15;
    }

    const savings = Math.max(0, studioCost - aiCost);
    const pct = studioCost > 0 ? Math.round((savings / studioCost) * 100) : 0;

    document.getElementById('res-studio')!.textContent = `$${Math.round(studioCost).toLocaleString('en-US')}/mo`;
    document.getElementById('res-ai')!.textContent = `$${Math.round(aiCost).toLocaleString('en-US')}/mo`;
    document.getElementById('res-save')!.textContent = `$${Math.round(savings).toLocaleString('en-US')}/mo`;
    document.getElementById('res-save-pct')!.textContent = `-${pct}%`;
    document.getElementById('res-plan')!.textContent = `${chosen.name} ($${chosen.price}/mo)`;
    document.getElementById('res-chars')!.textContent = `${totalChars.toLocaleString('en-US')} chars / mo`;
  }

  [minsEl, langsEl, humanEl].forEach((el) => el.addEventListener('input', updateVoice));
  updateVoice();
</script>
