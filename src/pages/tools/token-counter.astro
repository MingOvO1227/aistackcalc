---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TokenCounter from '../../components/TokenCounter.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import { TRANSLATIONS } from '../../i18n/translations';

const t = TRANSLATIONS.en.tokenCounter;
---
<BaseLayout
  title={t.title}
  description={t.subtitle}
  locale="en"
  canonicalPath="/tools/token-counter/"
  multilingualPath="tools/token-counter/"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <TokenCounter locale="en" />
    <AffiliateBanner locale="en" partnerKeys={['runpod', 'elevenlabs', 'webflow', 'zapier']} />
  </div>
</BaseLayout>
