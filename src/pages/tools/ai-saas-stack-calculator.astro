---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SaasStackCalculator from '../../components/SaasStackCalculator.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import { TRANSLATIONS } from '../../i18n/translations';

const t = TRANSLATIONS.en.stack;
---
<BaseLayout
  title={t.title}
  description={t.subtitle}
  locale="en"
  canonicalPath="/tools/ai-saas-stack-calculator/"
  multilingualPath="tools/ai-saas-stack-calculator/"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <SaasStackCalculator locale="en" />
    <AffiliateBanner locale="en" partnerKeys={['webflow', 'notion', 'zapier', 'activecampaign']} />
  </div>
</BaseLayout>
