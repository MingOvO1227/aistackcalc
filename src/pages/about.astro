---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config/site.json';
import modelsData from '../data/models.json';
import { formatDateShort } from '../utils/format';
---

<BaseLayout
  title="Methodology & About"
  description={`How ${siteConfig.siteName} collects and updates live AI API, voice generation, and Cloud GPU pricing daily.`}
  canonicalPath="/about/"
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
    <article class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-8 shadow-xs space-y-5 text-slate-700 dark:text-slate-300 leading-relaxed">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">About {siteConfig.siteName} & Pricing Methodology</h1>
      <p>
        {siteConfig.siteName} helps developers, startup founders, and operations teams estimate real-world monthly bills across LLM APIs, AI voice & dubbing platforms, dedicated Cloud GPUs, and no-code automation stacks.
      </p>
      <h2 class="text-xl font-bold text-slate-900 dark:text-white pt-2">Automated Daily Pricing Pipeline</h2>
      <p>
        LLM token rates change rapidly as providers launch new generations and cut inference costs. Rather than maintaining stale blog tables, our automated build pipeline syncs daily with live public API pricing feeds (OpenRouter Public Models API), normalizing per-1M input/output token rates and context lengths.
      </p>
      <p class="text-sm text-slate-500">
        Last automated sync: <strong>{formatDateShort(modelsData.updatedAt)}</strong> · Currently tracking <strong>{modelsData.models.length}</strong> curated production models.
      </p>
      <h2 class="text-xl font-bold text-slate-900 pt-2">Contact</h2>
      <p>
        Spotted a pricing discrepancy or want to suggest a calculator? Reach us at{' '}
        <a href={`mailto:${siteConfig.contactEmail}`} class="text-indigo-600 font-semibold hover:underline">
          {siteConfig.contactEmail}
        </a>.
      </p>
    </article>
  </div>
</BaseLayout>
