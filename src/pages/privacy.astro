---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config/site.json';
---

<BaseLayout
  title="Privacy Policy"
  description={`Privacy Policy for ${siteConfig.siteName}.`}
  canonicalPath="/privacy/"
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
    <article class="rounded-3xl border border-slate-200 bg-white p-8 shadow-xs space-y-5 text-slate-700 leading-relaxed">
      <h1 class="text-3xl font-extrabold text-slate-900">Privacy Policy</h1>
      <p>
        {siteConfig.siteName} respects your privacy. All interactive calculators on this site run 100% locally inside your web browser—the token counts, budgets, and usage figures you enter are never stored on our servers.
      </p>
      <h2 class="text-xl font-bold text-slate-900 pt-2">Information We Do Not Collect</h2>
      <p>
        We do not require user accounts, logins, credit cards, or personal data to use any calculator on this site.
      </p>
      <h2 class="text-xl font-bold text-slate-900 pt-2">Analytics & Third-Party Links</h2>
      <p>
        We may use privacy-friendly aggregated analytics and standard advertising/affiliate attribution cookies when you click outbound partner links. Please review the respective privacy policies of any external service you choose to visit.
      </p>
      <p>
        For privacy inquiries, email{' '}
        <a href={`mailto:${siteConfig.contactEmail}`} class="text-indigo-600 font-semibold hover:underline">
          {siteConfig.contactEmail}
        </a>.
      </p>
    </article>
  </div>
</BaseLayout>
