---
import CompareIndexView from '../../../components/CompareIndexView.astro';
import type { Locale } from '../../../i18n/translations';

export function getStaticPaths() {
  return ['zh', 'ja', 'de', 'es', 'fr'].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
---
<CompareIndexView locale={lang} />
