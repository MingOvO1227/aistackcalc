---
import CompareDetailView from '../../../components/CompareDetailView.astro';
import modelsData from '../../../data/models.json';
import type { Locale } from '../../../i18n/translations';

export function getStaticPaths() {
  const langs: Locale[] = ['zh', 'ja', 'de', 'es', 'fr'];
  const bySlug = new Map(modelsData.models.map((m) => [m.slug, m]));
  const paths = [];
  for (const lang of langs) {
    for (const c of modelsData.comparisons) {
      const a = bySlug.get(c.modelA);
      const b = bySlug.get(c.modelB);
      if (!a || !b) continue;
      paths.push({ params: { lang, slug: c.slug }, props: { a, b } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const { a, b } = Astro.props;
---
<CompareDetailView locale={lang} a={a} b={b} />
