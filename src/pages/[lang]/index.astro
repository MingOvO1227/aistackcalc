---
import HomePageView from '../../components/HomePageView.astro';
import type { Locale } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh' } },
    { params: { lang: 'ja' } },
    { params: { lang: 'de' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const lang = Astro.params.lang as Locale;
---
<HomePageView locale={lang} />
