---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GpuCalculator from '../../../components/GpuCalculator.astro';
import AffiliateBanner from '../../../components/AffiliateBanner.astro';
import { TRANSLATIONS, localePath, type Locale } from '../../../i18n/translations';

export function getStaticPaths() {
  return ['zh', 'ja', 'de', 'es', 'fr'].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = TRANSLATIONS[lang].gpu;
---
<BaseLayout
  title={t.title}
  description={t.subtitle}
  locale={lang}
  canonicalPath={localePath(lang, 'tools/gpu-vs-api-calculator/')}
  multilingualPath="tools/gpu-vs-api-calculator/"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <GpuCalculator locale={lang} />
    <AffiliateBanner locale={lang} partnerKeys={['runpod', 'zapier', 'notion', 'glide']} />
  </div>
</BaseLayout>
