---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import VoiceCalculator from '../../../components/VoiceCalculator.astro';
import AffiliateBanner from '../../../components/AffiliateBanner.astro';
import { TRANSLATIONS, localePath, type Locale } from '../../../i18n/translations';

export function getStaticPaths() {
  return ['zh', 'ja', 'de', 'es', 'fr'].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = TRANSLATIONS[lang].voice;
---
<BaseLayout
  title={t.title}
  description={t.subtitle}
  locale={lang}
  canonicalPath={localePath(lang, 'tools/ai-voice-cost-calculator/')}
  multilingualPath="tools/ai-voice-cost-calculator/"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <VoiceCalculator locale={lang} />
    <AffiliateBanner locale={lang} partnerKeys={['elevenlabs', 'webflow', 'zapier', 'activecampaign']} />
  </div>
</BaseLayout>
