---
import '../styles/global.css';
import siteConfig from '../config/site.json';
import modelsData from '../data/models.json';
import { LOCALES, TRANSLATIONS, localePath, type Locale } from '../i18n/translations';
import { formatDateShort } from '../utils/format';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  canonicalPath?: string;
  multilingualPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  locale = 'en',
  canonicalPath = '/',
  multilingualPath,
  jsonLd
} = Astro.props;

const t = TRANSLATIONS[locale];
const base = siteConfig.siteUrl.replace(/\/$/, '');
const fullCanonical = `${base}${canonicalPath.startsWith('/') ? canonicalPath : '/' + canonicalPath}`;
const syncedDate = formatDateShort(modelsData.updatedAt);
const pageTitle = title.includes(siteConfig.siteName) ? title : `${title} | ${siteConfig.siteName}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    {multilingualPath !== undefined && (
      <>
        {LOCALES.map((loc) => (
          <link
            rel="alternate"
            hreflang={loc.hreflang}
            href={`${base}${localePath(loc.code, multilingualPath)}`}
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={`${base}${localePath('en', multilingualPath)}`} />
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    {siteConfig.googleSiteVerification && (
      <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
    )}
    {siteConfig.bingSiteVerification && (
      <meta name="msvalidate.01" content={siteConfig.bingSiteVerification} />
    )}
    {siteConfig.adsensePublisherId && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.adsensePublisherId}`}
        crossorigin="anonymous"
      ></script>
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-slate-200/80 dark:border-slate-800/80 bg-white/85 dark:bg-slate-950/85 backdrop-blur-xl transition-colors">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
        <a href={localePath(locale)} class="flex items-center gap-2.5 shrink-0 group">
          <div class="h-8 w-8 rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 flex items-center justify-center text-white font-extrabold text-sm shadow-sm shadow-indigo-500/30 group-hover:scale-105 transition">
            AI
          </div>
          <span class="font-extrabold text-slate-900 dark:text-white tracking-tight text-lg">{siteConfig.siteName}</span>
        </a>

        <nav class="hidden xl:flex items-center gap-0.5 text-sm font-medium text-slate-600 dark:text-slate-300 whitespace-nowrap">
          <a href={localePath(locale)} class="px-3 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap">
            {t.nav.llmCalc}
          </a>
          <a href={localePath(locale, 'tools/token-counter/')} class="px-3 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap">
            {t.nav.tokenCounter}
          </a>
          <a href={localePath(locale, 'tools/ai-voice-cost-calculator/')} class="px-3 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap">
            {t.nav.voiceCalc}
          </a>
          <a href={localePath(locale, 'tools/gpu-vs-api-calculator/')} class="px-3 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap">
            {t.nav.gpuCalc}
          </a>
          <a href={localePath(locale, 'tools/ai-saas-stack-calculator/')} class="px-3 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap">
            {t.nav.stackCalc}
          </a>
          <a href={localePath(locale, 'compare/')} class="px-3 py-2 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 hover:text-slate-900 dark:hover:text-white transition whitespace-nowrap">
            {t.nav.compare}
          </a>
        </nav>

        <div class="flex items-center gap-2 shrink-0">
          <div class="flex items-center bg-slate-100 dark:bg-slate-900 border border-slate-200/70 dark:border-slate-800 rounded-xl p-0.5 text-xs font-medium whitespace-nowrap">
            {LOCALES.map((loc) => (
              <a
                href={localePath(loc.code, multilingualPath ?? '')}
                class={`px-2 py-1 rounded-lg transition whitespace-nowrap ${
                  loc.code === locale
                    ? 'bg-white dark:bg-slate-800 text-indigo-700 dark:text-indigo-300 shadow-xs font-semibold'
                    : 'text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white'
                }`}
                title={loc.label}
              >
                {loc.native}
              </a>
            ))}
          </div>

          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle dark mode"
            title={t.nav.toggleTheme}
            class="h-8 w-8 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-amber-300 hover:border-indigo-400 dark:hover:border-indigo-500 hover:text-indigo-600 flex items-center justify-center transition cursor-pointer shrink-0"
          >
            <svg id="icon-sun" class="hidden dark:block h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32l1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <svg id="icon-moon" class="block dark:hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="xl:hidden border-t border-slate-100 dark:border-slate-800/80 px-4 py-2 flex items-center gap-2 overflow-x-auto text-xs font-medium text-slate-600 dark:text-slate-300">
        <a href={localePath(locale)} class="px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800 shrink-0">{t.nav.llmCalc}</a>
        <a href={localePath(locale, 'tools/token-counter/')} class="px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800 shrink-0">{t.nav.tokenCounter}</a>
        <a href={localePath(locale, 'tools/ai-voice-cost-calculator/')} class="px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800 shrink-0">{t.nav.voiceCalc}</a>
        <a href={localePath(locale, 'tools/gpu-vs-api-calculator/')} class="px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800 shrink-0">{t.nav.gpuCalc}</a>
        <a href={localePath(locale, 'tools/ai-saas-stack-calculator/')} class="px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800 shrink-0">{t.nav.stackCalc}</a>
        <a href={localePath(locale, 'compare/')} class="px-2.5 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800 shrink-0">{t.nav.compare}</a>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 mt-16 transition-colors">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-bold text-slate-900 dark:text-white">{siteConfig.siteName}</span>
              <span class="inline-flex items-center gap-1.5 text-xs bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/70 px-2.5 py-0.5 rounded-full font-medium">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                {t.footer.syncedPrefix} {syncedDate}
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 max-w-md">
              {t.partners.disclosureShort}
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-5 text-sm text-slate-600 dark:text-slate-400">
            <a href="/about/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">{t.footer.about}</a>
            <a href="/disclosure/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">{t.footer.disclosure}</a>
            <a href="/privacy/" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition">{t.footer.privacy}</a>
          </div>
        </div>
        <div class="mt-6 pt-6 border-t border-slate-100 dark:border-slate-800/80 text-xs text-slate-400 dark:text-slate-500 flex flex-col sm:flex-row justify-between gap-2">
          <span>© {new Date().getFullYear()} {siteConfig.siteName}. {t.footer.rights}</span>
          <span>Data source: OpenRouter Live Pricing Feed & Official Vendor Plans</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var isDark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
